# ─── Frontend (Vite) — copy to .env ──────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API → Project URL & anon/public key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key...

# ─── Seed Script (Node) — copy to supabase/.env.factory-secrets ──────────────
# Get SUPABASE_SERVICE_ROLE_KEY from: Project Settings → API → service_role (secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key...never_commit_this

# ─── Account passwords for the 6 seeded logins (min 10 characters each) ──────
FACTORY_PASSWORD_1=change_me_factory1_min10chars
FACTORY_PASSWORD_2=change_me_factory2_min10chars
FACTORY_PASSWORD_3=change_me_factory3_min10chars
FACTORY_PASSWORD_4=change_me_factory4_min10chars
FACTORY_PASSWORD_5=change_me_factory5_min10chars
RETAILER_PASSWORD=change_me_retailer_min10chars
